{
  "name": "open-golf-tracer",
  "private": true,
  "license": "MIT",
  "version": "0.6.0",
  "description": "Open Golf Tracer – webeditor til golfvideoer med automatisk shot tracer",
  "workspaces": [
    "packages/schema",
    "packages/physics",
    "packages/render",
    "packages/compose",
    "apps/web",
    "apps/exporter"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @golf/web && npm run build -w @golf/exporter",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:schema": "tsx packages/schema/scripts/gen-json-schema.ts",
    "brand": "node scripts/make-brand.mjs",
    "demo": "node scripts/py.mjs scripts/make_demo.py --analyze",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:py": "node scripts/py.mjs -m pytest",
    "autovideo": "tsx apps/exporter/src/autovideo.ts",
    "lock:py": "node scripts/lock-python.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "@tailwindcss/oxide@4.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module"
}
