# Open Golf Tracer – copy to .env and adjust (setup does the copy). Everything has a sensible
# local default; nothing here is required to run on your own machine.
# Internal secrets are generated automatically on first start (data/.secret, data/.internal-token).

# Where the database (SQLite), videos and exports are stored.
# DATA_DIR=./data

# Limits for a single video. Unset = default.
# MAX_UPLOAD_BYTES=20000000000          # largest single upload (default 20 GB)
# MAX_VIDEO_SECONDS=7200                # longest video (default 2 hours)

# Ball detector: "rfdetr" (default: RF-DETR as ONNX, Apache-2.0), "rfdetr-torch" (the same in PyTorch,
# needs requirements-torch.txt), "yolo" (AGPL – see docs/licensing.md) or "blob" (no ML).
# GOLF_DETECTOR=rfdetr
# HDR videos are analysed as the raw signal (best on real iPhone clips); 1 tone-maps to SDR first.
# GOLF_HDR_TONEMAP=0
# Proxy codec for the editor preview: h264 (default) or vp9 (browsers without H.264, e.g. Chromium builds).
# PROXY_CODEC=h264
# Videos prepared at once (preview, thumbnails, waveform). Default 2, or 1 with 4 CPU cores or fewer.
# INGEST_PARALLEL=2
# Force CPU encoding in the exporter even when a GPU encoder exists.
# EXPORT_CPU=1

# Satellite map in "Measure on map": auto = only on localhost/home network (Esri needs a licence online); 1 = always, 0 = never
# NEXT_PUBLIC_MAP_SATELLITE=

# There is NO login: whoever can open the web app can see and change every project.
# So by default the web app only listens on this PC (127.0.0.1). Set LISTEN_HOST=0.0.0.0 to
# open it to your network – only on a network you trust. The API always stays on 127.0.0.1.
# See "Use it from another device" in the README.
# LISTEN_HOST=127.0.0.1
# Opening it by a name instead of an IP (e.g. http://mypc.local:3000)? List the name(s) here, comma separated.
# ALLOWED_HOSTS=mypc.local

LOG_LEVEL=INFO

# Optional AI model for "Make a video for me" (can be overridden under Settings → AI).
# The model gets a text summary of the round – never video or the project; still frames only with AI_VISION=1.
# none (default, fixed rules) | ollama | openai-compatible | anthropic
AI_PROVIDER=none
# Empty = the provider's default (ollama: llama3.1, openai-compatible: gpt-4o-mini, anthropic: claude-opus-5-5)
# AI_MODEL=
# Empty = default (ollama: http://localhost:11434/v1, openai-compatible: https://api.openai.com/v1,
# anthropic: https://api.anthropic.com). LM Studio: http://localhost:1234/v1, OpenRouter: https://openrouter.ai/api/v1
# AI_BASE_URL=
# Never sent to the browser, logged, or stored in projects or data exports.
# AI_API_KEY=
# Stop with an error when one video would use more tokens than this (input + output, all calls).
AI_MAX_TOKENS=8000
# 1 = when the putt count on a hole is unsure, the model looks at a few still frames from the green
# instead of asking (needs a model that can see images). With Ollama they stay on the PC; with a cloud
# provider they are sent there. Each look costs about 5 000 tokens.
AI_VISION=0
