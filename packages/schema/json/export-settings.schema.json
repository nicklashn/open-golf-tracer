{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preset": {
      "default": "shorts",
      "type": "string",
      "enum": [
        "shorts",
        "youtube1080",
        "youtube4k",
        "original"
      ]
    },
    "fps": {
      "default": "source",
      "anyOf": [
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        },
        {
          "type": "string",
          "const": "source"
        }
      ]
    },
    "hdr": {
      "default": "keep",
      "type": "string",
      "enum": [
        "keep",
        "sdr"
      ]
    },
    "range": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            }
          },
          "required": [
            "start",
            "end"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
